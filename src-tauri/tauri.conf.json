{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHTool2",
  "version": "0.16.0",
  "identifier": "com.seonghwanlee.sshtool2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSHTool2",
        "width": 1000,
        "height": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SeonghwanLee/SSHTool2/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNkVCNUYzNEQ0RDc5RjMKUldUemVVMU44N1Z1WDNDM041MW5uUThMeUJlMVlZN0JCSVV6UnFRbWZpRkJFSWVCTkhlVy9UV0QK"
    }
  }
}
