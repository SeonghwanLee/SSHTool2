{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHTool2",
  "version": "0.85.1",
  "identifier": "com.seonghwanlee.sshtool2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSHTool2",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SeonghwanLee/SSHTool2/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNkVCNUYzNEQ0RDc5RjMKUldUemVVMU44N1Z1WDNDM041MW5uUThMeUJlMVlZN0JCSVV6UnFRbWZpRkJFSWVCTkhlVy9UV0QK"
    }
  }
}
